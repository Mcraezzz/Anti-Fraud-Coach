DASHSCOPE_API_KEY=sk-your-api-key-here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-plus
QWEN_TIMEOUT_SECONDS=30
DATASETS_DIR=D:\CARIC模型&数据集\datasets
MODELS_DIR=D:\CARIC模型&数据集\models
BGE_M3_PATH=D:\CARIC模型&数据集\models\BAAI_bge-m3
RERANKER_PATH=D:\CARIC模型&数据集\models\BAAI_bge-reranker-v2-m3
OCR_MODEL_ROOT=D:\CARIC模型&数据集\models\PaddleOCR
BGE_BATCH_SIZE=8
BGE_MAX_SEQ_LENGTH=512
BGE_DENSE_LIMIT=0
BGE_DEVICE=auto
USE_RERANKER=true
RERANKER_TOP_N=12
RERANKER_WEIGHT=0.30
RERANKER_MAX_LENGTH=512
FUSION_ALPHA=0.35
FUSION_BETA=0.35
FUSION_GAMMA=0.15
FUSION_DELTA=0.15
USE_OCR=true
OCR_LANG=ch
