/* ===== Hero ===== */
.coach-hero {
  min-height: 440rpx;
  padding: 40rpx 36rpx 36rpx;
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

/* Hero Text */
.hero-line {
  margin-top: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.5;
}

/* Security Row */
.security-row {
  display: flex;
  align-items: center;
  margin-top: 32rpx;
}

/* Score Ring */
.score-ring {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  width: 148rpx;
  height: 148rpx;
  border-radius: 50%;
  background: conic-gradient(from -90deg, #34D399 0deg 309.6deg, rgba(255, 255, 255, 0.15) 309.6deg 360deg);
}

.score-ring::before {
  position: absolute;
  inset: 8rpx;
  border-radius: 50%;
  background: #1E3A5F;
  content: "";
}

.score-number {
  position: relative;
  color: #FFFFFF;
  font-size: 44rpx;
  font-weight: 700;
  z-index: 1;
}

.score-label {
  position: relative;
  color: rgba(255, 255, 255, 0.65);
  font-size: 24rpx;
  z-index: 1;
  margin-top: 4rpx;
}

/* Hero Metrics */
.hero-metrics {
  flex: 1;
  margin-left: 28rpx;
}

.hero-metric {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
  padding: 0 24rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.7);
  font-size: 26rpx;
  font-weight: 500;
}

.hero-metric text:last-child {
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 700;
}

.hero-metric + .hero-metric {
  margin-top: 12rpx;
}

/* ===== Scan Grid ===== */
.scan-grid {
  display: flex;
  flex-wrap: wrap;
  margin-left: -14rpx;
}

.scan-card {
  display: flex;
  align-items: center;
  width: calc(50% - 14rpx);
  min-height: 132rpx;
  margin-left: 14rpx;
  margin-bottom: 14rpx;
  padding: 22rpx;
  border-radius: var(--radius-sm);
  background: #F8FAFC;
  box-sizing: border-box;
  transition: background 0.2s ease;
}

.scan-card:active {
  background: #F1F5F9;
}

.scan-icon {
  flex: none;
  width: 60rpx;
  height: 60rpx;
  margin-right: 18rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.scan-icon-img {
  width: 36rpx;
  height: 36rpx;
}

.scan-icon-text {
  background: #2563EB;
}

.scan-icon-image {
  background: #059669;
}

.scan-icon-link {
  background: #D97706;
}

.scan-icon-sms {
  background: #DC2626;
}

.scan-title {
  color: var(--text-main);
  font-size: 30rpx;
  font-weight: 600;
}

.scan-desc {
  margin-top: 6rpx;
  color: var(--text-secondary);
  font-size: 24rpx;
  line-height: 34rpx;
}

/* ===== Quick Text Area ===== */
.privacy-bar {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--radius-sm);
  color: #047857;
  background: #F0FDF4;
  font-size: 24rpx;
  line-height: 36rpx;
  font-weight: 500;
  border-left: 4rpx solid #34D399;
}

.actions {
  display: flex;
  margin-top: 24rpx;
  gap: 16rpx;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
}

/* ===== Feature Grid ===== */
.feature-grid {
  display: flex;
  flex-wrap: wrap;
  margin-left: -14rpx;
}

.feature-card {
  width: calc(50% - 14rpx);
  min-height: 148rpx;
  margin-left: 14rpx;
  margin-bottom: 14rpx;
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  background: var(--surface);
  border-radius: var(--radius-md);
  box-sizing: border-box;
  border: 1rpx solid var(--border);
  transition: background 0.2s ease;
}

.feature-card:active {
  background: #F8FAFC;
}

.feature-title {
  color: var(--text-main);
  font-size: 30rpx;
  font-weight: 600;
}

.feature-desc {
  margin-top: 8rpx;
  color: var(--text-secondary);
  font-size: 24rpx;
  line-height: 36rpx;
}

/* ===== Warning Card ===== */
.warning-card {
  position: relative;
  padding: 28rpx 28rpx 28rpx 32rpx;
  border-radius: var(--radius-md);
  background: #FFFBEB;
  border: 1rpx solid #FDE68A;
  overflow: hidden;
}

.warning-card::before {
  position: absolute;
  left: 0;
  top: 16rpx;
  bottom: 16rpx;
  width: 6rpx;
  border-radius: 0 4rpx 4rpx 0;
  background: #F59E0B;
  content: "";
}

.warning-title {
  color: #92400E;
  font-size: 28rpx;
  font-weight: 600;
  position: relative;
  z-index: 1;
}

.warning-body {
  margin-top: 10rpx;
  color: #A16207;
  font-size: 26rpx;
  line-height: 40rpx;
  position: relative;
  z-index: 1;
}
