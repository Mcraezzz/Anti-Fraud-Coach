<view class="no-tab">
  <coach-safe />
  <view class="compact-header">
    <view class="inline">
      <button class="back" bindtap="back"><ui-icon name="chevron-left" tone="slate" /></button>
      <view>
        <view class="compact-title">{{scenario.title || '情景对抗演练'}}</view>
        <view class="mini">情景实战 · 识别话术陷阱</view>
      </view>
    </view>
    <button class="icon-button" bindtap="openHandbook">
      <ui-icon name="book-open" tone="slate" size="{{18}}" />
    </button>
  </view>
  <view class="content">
    <view wx:if="{{error}}" class="error">
      {{error}}
      <button class="link" bindtap="{{scenario?'submit':'load'}}">重试</button>
    </view>
    <view wx:if="{{loading}}" class="loading">正在准备情景...</view>
    <block wx:if="{{scenario}}">
      <view class="row" style="margin-bottom: 16px">
        <view
          class="icon-box"
          style="border-radius: 50%; background: #e2e8f0; color: #64748b; font-weight: 700"
        >
          {{scenario.scammerAvatarText}}
        </view>
        <view class="grow">
          <view class="list-title">{{scenario.scammerRole}}</view>
          <view class="mini">模拟对话 · 请勿进行真实交易</view>
        </view>
        <text class="mini">{{step+1}} / {{scenario.turns.length}}</text>
      </view>
      <view wx:for="{{turn.messages}}" wx:key="*this" class="bubble assistant">{{item}}</view>
      <view class="card" style="margin-top: 24px">
        <view class="section-title">{{turn.promptQuestion}}</view>
        <button
          wx:for="{{turn.actions}}"
          wx:key="id"
          class="option {{selection===item.id?'selected':''}}"
          data-id="{{item.id}}"
          bindtap="choose"
          disabled="{{busy || result}}"
        >
          {{item.label}}
        </button>
        <view wx:if="{{busy}}" class="muted">正在评估你的选择...</view>
      </view>
      <view wx:if="{{result}}" class="card">
        <view wx:for="{{result.feedback}}" wx:key="turnId">
          <view class="inline" style="margin-bottom: 12px">
            <ui-icon
              name="{{item.tier==='best'?'circle-check':item.tier==='danger'?'circle-x':'info'}}"
              tone="{{item.tier==='best'?'green':item.tier==='danger'?'red':'orange'}}"
              size="{{22}}"
            />
            <view class="list-title">{{item.feedbackTitle}}</view>
          </view>
          <view class="muted" style="color: #334155">{{item.feedbackBody}}</view>
          <view class="divider" />
          <view class="mini" style="margin-bottom: 8px">本次识别出的风险信号</view>
          <text
            wx:for="{{item.identifiedSignals}}"
            wx:for-item="signal"
            wx:key="*this"
            class="tag safe"
          >
            {{signal}}
          </text>
          <text
            wx:for="{{item.missedSignals}}"
            wx:for-item="signal"
            wx:key="*this"
            class="tag medium"
          >
            待强化：{{signal}}
          </text>
        </view>
        <view class="row" style="margin-top: 16px">
          <view class="muted">本次训练得分</view>
          <view class="list-title blue">{{result.score}} / 100</view>
        </view>
        <button
          class="primary"
          style="margin-top: 16px"
          bindtap="go"
          data-url="/pages/report/index"
        >
          查看能力报告 →
        </button>
        <button class="link" bindtap="reset">重新演练</button>
      </view>
    </block>
  </view>
  <coach-sheet
    open="{{showHandbook}}"
    title="{{scenario.handbook.title || ''}}"
    subtitle="防骗核心指南"
    bindclose="closeHandbook"
  >
    <view class="explanation" style="margin-top: 0">{{scenario.handbook.coreRule}}</view>
    <view class="section-title" style="margin-top: 20px">高频危险信号</view>
    <view wx:for="{{scenario.handbook.redFlags}}" wx:key="*this" class="list-row muted">
      {{item}}
    </view>
    <view class="section-title" style="margin-top: 20px">核实与处置步骤</view>
    <view wx:for="{{scenario.handbook.verifySteps}}" wx:key="*this" class="list-row muted">
      {{index+1}}. {{item}}
    </view>
  </coach-sheet>
</view>
