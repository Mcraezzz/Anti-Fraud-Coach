/* ===== Risk Overview Hero ===== */
.risk-overview {
  min-height: 420rpx;
  padding: 36rpx;
}

.risk-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.risk-badge {
  min-width: 120rpx;
  height: 52rpx;
  padding: 0 20rpx;
  border-radius: 26rpx;
  color: #FFFFFF;
  background: #DC2626;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 52rpx;
  text-align: center;
}

/* Gauge Ring */
.gauge {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  width: 200rpx;
  height: 200rpx;
  margin: 32rpx auto 28rpx;
  border-radius: 50%;
  background: conic-gradient(from -90deg, #EF4444 0deg 313.2deg, rgba(255, 255, 255, 0.15) 313.2deg 360deg);
}

.gauge::before {
  position: absolute;
  inset: 10rpx;
  border-radius: 50%;
  background: #1E3A5F;
  content: "";
}

.gauge-score {
  position: relative;
  color: #FFFFFF;
  font-size: 64rpx;
  font-weight: 700;
  z-index: 1;
}

.gauge-label {
  position: relative;
  color: rgba(255, 255, 255, 0.6);
  font-size: 22rpx;
  z-index: 1;
  margin-top: 4rpx;
}

/* Risk Meta */
.risk-meta {
  display: flex;
  gap: 14rpx;
}

.risk-meta > view {
  flex: 1;
  min-height: 96rpx;
  padding: 18rpx 20rpx;
  border-radius: var(--radius-sm);
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.meta-label {
  color: rgba(255, 255, 255, 0.55);
  font-size: 24rpx;
}

.meta-value {
  margin-top: 8rpx;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
}

/* ===== Summary & Evidence ===== */
.summary {
  color: var(--text-secondary);
  font-size: 28rpx;
  line-height: 48rpx;
}

.evidence-box {
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: var(--radius-sm);
  color: var(--text-main);
  background: #F8FAFC;
  font-size: 28rpx;
  line-height: 48rpx;
  border: 1rpx solid var(--border);
}

.risk-fragment {
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  border-bottom: 2rpx solid #FCA5A5;
  color: #991B1B;
  background: #FEF2F2;
  font-weight: 600;
}

.risk-marker {
  display: inline-block;
  min-width: 24rpx;
  height: 24rpx;
  margin-right: 4rpx;
  border-radius: 50%;
  color: #FFFFFF;
  background: #DC2626;
  font-size: 16rpx;
  line-height: 24rpx;
  text-align: center;
  vertical-align: 3rpx;
}

/* ===== Model Insights ===== */
.model-row {
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.model-row:last-child {
  border-bottom: none;
}

.model-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--text-main);
  font-size: 28rpx;
  font-weight: 600;
}

.model-status {
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  color: var(--primary);
  background: #EFF6FF;
  font-size: 24rpx;
  font-weight: 600;
}

.model-label {
  margin-top: 10rpx;
  color: #047857;
  font-size: 26rpx;
  font-weight: 600;
}

.model-detail {
  margin-top: 8rpx;
  color: var(--text-secondary);
  font-size: 26rpx;
  line-height: 42rpx;
}

/* ===== Advice Panel ===== */
.advice-panel {
  background: #F0FDF4;
  border: 1rpx solid #BBF7D0;
}

/* ===== OCR Timeline ===== */
.ocr-meta {
  margin-bottom: 20rpx;
  color: var(--text-secondary);
  font-size: 26rpx;
  font-weight: 500;
}

.timeline-row {
  margin-bottom: 16rpx;
  padding: 20rpx;
  border-radius: var(--radius-sm);
  background: #F8FAFC;
  border: 1rpx solid var(--border);
  transition: background 0.2s ease;
}

.timeline-row:active {
  background: #F1F5F9;
}

.timeline-self {
  background: #F0FDF4;
  border-left: 4rpx solid #34D399;
}

.timeline-head {
  color: var(--primary);
  font-size: 24rpx;
  font-weight: 600;
}

.timeline-text {
  margin-top: 8rpx;
  color: var(--text-main);
  font-size: 28rpx;
  line-height: 44rpx;
}

/* ===== Signals ===== */
.signal-row {
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.signal-row:last-child {
  border-bottom: none;
}

.signal-desc {
  margin-top: 10rpx;
  color: var(--text-secondary);
  font-size: 26rpx;
  line-height: 42rpx;
}

/* ===== Action Items ===== */
.action-item {
  display: flex;
  align-items: flex-start;
  min-height: 52rpx;
  color: var(--text-main);
  font-size: 28rpx;
  line-height: 46rpx;
  padding: 8rpx 0;
}

.action-dot {
  flex: none;
  width: 16rpx;
  height: 16rpx;
  margin-top: 16rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  background: #34D399;
}

/* ===== Source Card ===== */
.source-card {
  margin-bottom: 24rpx;
  padding: 24rpx;
  border-radius: var(--radius-md);
  color: #065F46;
  background: #F0FDF4;
  border: 1rpx solid #BBF7D0;
}

.source-title {
  font-size: 28rpx;
  font-weight: 600;
}

.source-line {
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 40rpx;
  color: #047857;
}

/* ===== Training CTA ===== */
.result-actions {
  margin-bottom: 16rpx;
}

.rescan-btn {
  margin-bottom: 48rpx;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 30rpx;
}
