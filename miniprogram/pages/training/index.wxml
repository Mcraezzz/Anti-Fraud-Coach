<view class="page">
  <coach-safe />
  <view class="header">
    <view class="title inline">
      <ui-icon name="target" tone="orange" />
      反诈情景训练营
    </view>
    <view class="subtitle">覆盖校园六大高频诈骗场景，实战演练识别话术</view>
    <view class="grid" style="margin-top: 16px">
      <view class="half notice inline" style="border-radius: 12px; padding: 12px 14px">
        <ui-icon name="trophy" tone="orange" />
        <view>
          <view class="mini" style="color: #64748b">当前防诈等级</view>
          <view style="font-size: 12px; font-weight: 700">
            Lv.{{report.completed>=5?6:1+(report.completed || 0)}}
            {{report.completed>=5?'校园防诈专家':report.completed>=3?'风险辨别能手':'风险识别新手'}}
          </view>
        </view>
      </view>
      <view
        class="half"
        style=" border: 1px solid #dbeafe; background: #eff6ffb3; border-radius: 12px; padding: 12px 14px; "
      >
        <view class="mini" style="color: #64748b">已通关情景</view>
        <view style="font-size: 14px; font-weight: 700; margin-top: 2px">
          <text class="blue">{{report.completed || 0}}</text>
          / 6 关
        </view>
      </view>
    </view>
    <view class="tabs" style="margin-top: 4px">
      <button
        wx:for="{{filters}}"
        wx:key="id"
        class="tab {{filter===item.id?'active':''}}"
        data-id="{{item.id}}"
        bindtap="filter"
      >
        {{item.label}}
      </button>
    </view>
  </view>
  <view class="content">
    <view wx:if="{{error}}" class="error">
      {{error}}
      <button class="link" bindtap="load">重试</button>
    </view>
    <view wx:if="{{loading}}" class="loading">正在加载情景...</view>
    <view wx:for="{{filtered}}" wx:key="id" class="card training-card row">
      <view class="grow" bindtap="go" data-url="/pages/training-detail/index?id={{item.id}}">
        <view class="training-meta">
          <text class="difficulty-{{item.difficulty}}">{{item.level}}</text>
          <text>·</text>
          <text>{{item.category}}</text>
          <text wx:if="{{item.completed}}" class="green">· 最高 {{item.bestScore}}分</text>
        </view>
        <view class="training-title">{{item.title}}</view>
        <view class="subtitle">{{item.subtitle}}</view>
      </view>
      <view class="inline" style="gap: 4px">
        <button class="icon-button" data-id="{{item.id}}" bindtap="handbook" aria-label="防范手册">
          <ui-icon name="book-open" tone="muted" size="{{18}}" />
        </button>
        <button
          class="icon-button"
          data-url="/pages/training-detail/index?id={{item.id}}"
          bindtap="go"
          aria-label="开始训练"
        >
          <ui-icon name="circle-play" size="{{24}}" />
        </button>
      </view>
    </view>
    <view wx:if="{{!loading && !error && !filtered.length}}" class="empty">暂无该难度的情景</view>
  </view>
  <coach-sheet
    open="{{!!handbook}}"
    title="{{handbook.title || ''}}"
    subtitle="防骗核心指南"
    bindclose="closeHandbook"
  >
    <view class="explanation" style="margin-top: 0">
      <view class="mini blue" style="font-weight: 700">核心铁律</view>
      <view class="list-title" style="margin-top: 4px">{{handbook.coreRule}}</view>
    </view>
    <view class="section-title" style="margin-top: 20px">高频危险信号</view>
    <view wx:for="{{handbook.redFlags}}" wx:key="*this" class="muted" style="margin-bottom: 8px">
      • {{item}}
    </view>
    <view class="section-title" style="margin-top: 20px">核实与处置步骤</view>
    <view wx:for="{{handbook.verifySteps}}" wx:key="*this" class="muted" style="margin-bottom: 8px">
      {{index+1}}. {{item}}
    </view>
    <view class="notice" style="margin-top: 16px">{{handbook.emergencyAction}}</view>
  </coach-sheet>
  <coach-nav active="training" />
</view>
