/* ===== Camp Card (Hero) ===== */
.camp-card {
  min-height: 240rpx;
}

.task-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 28rpx;
  padding: 22rpx 24rpx;
  border-radius: var(--radius-sm);
  background: rgba(255, 255, 255, 0.1);
  font-size: 26rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.8);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.progress-panel {
  padding: 28rpx;
}

.progress-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--text-main);
  font-size: 28rpx;
  font-weight: 700;
}

.progress-track {
  height: 16rpx;
  margin-top: 18rpx;
  border-radius: 16rpx;
  background: #E2E8F0;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 16rpx;
  background: var(--primary);
  transition: width 0.2s ease;
}

.progress-note {
  margin-top: 14rpx;
  color: var(--text-secondary);
  font-size: 24rpx;
  line-height: 36rpx;
}

/* ===== Score Panel ===== */
.score-panel {
  text-align: center;
  padding: 40rpx;
}

.score {
  color: var(--primary);
  font-size: 88rpx;
  font-weight: 700;
  line-height: 96rpx;
}

.small-title {
  margin-top: 24rpx;
  margin-bottom: 12rpx;
}

/* ===== Scenario Grid ===== */
.scenario-grid {
  display: flex;
  flex-wrap: wrap;
  margin-left: -14rpx;
  margin-bottom: 8rpx;
}

.scenario-card {
  position: relative;
  width: calc(50% - 14rpx);
  min-height: 140rpx;
  margin-left: 14rpx;
  margin-bottom: 14rpx;
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  overflow: hidden;
  transition: background 0.2s ease;
}

.scenario-card:active {
  background: #F8FAFC;
}

.scenario-title {
  color: var(--text-main);
  font-size: 30rpx;
  font-weight: 600;
}

.scenario-level {
  margin-top: 8rpx;
  color: var(--text-secondary);
  font-size: 24rpx;
  line-height: 36rpx;
}

/* ===== Question Panel ===== */
.question {
  margin-bottom: 24rpx;
}

.question-missing {
  border-color: #FCA5A5;
  background: #FFFBFB;
}

.meta {
  margin-bottom: 16rpx;
}

.q-title {
  color: var(--text-main);
  font-size: 32rpx;
  font-weight: 600;
  line-height: 48rpx;
  margin-bottom: 12rpx;
}

.prompt {
  color: var(--text-secondary);
  font-size: 28rpx;
  line-height: 46rpx;
  margin-bottom: 20rpx;
  padding: 20rpx;
  border-radius: var(--radius-sm);
  background: #F8FAFC;
  border-left: 4rpx solid var(--primary-light);
}

/* ===== Options ===== */
.option {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-top: 16rpx;
  border: 2rpx solid var(--border);
  border-radius: var(--radius-sm);
  background: #FFFFFF;
  transition: all 0.2s ease;
}

.option:active {
  border-color: var(--primary-light);
}

.option-active {
  border-color: var(--primary);
  background: #EFF6FF;
}

.option-key {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 48rpx;
  height: 48rpx;
  margin-right: 18rpx;
  border-radius: 50%;
  color: #FFFFFF;
  background: var(--primary);
  font-weight: 600;
  font-size: 24rpx;
}

.option-active .option-key {
  background: #059669;
}

.option-text {
  color: var(--text-main);
  font-size: 28rpx;
  line-height: 44rpx;
  font-weight: 500;
}

/* ===== Submit Button ===== */
.submit-btn {
  margin: 16rpx 0 32rpx;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 30rpx;
}

/* ===== Review ===== */
.review-item {
  padding: 24rpx;
  margin-bottom: 16rpx;
  border-radius: var(--radius-sm);
  background: #F8FAFC;
  border: 1rpx solid var(--border);
  transition: background 0.2s ease;
}

.review-item:active {
  background: #F1F5F9;
}

.review-title {
  color: var(--text-main);
  font-size: 28rpx;
  font-weight: 600;
}

.ok {
  display: inline-block;
  margin-top: 8rpx;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  color: #047857;
  background: #D1FAE5;
  font-size: 24rpx;
  font-weight: 600;
}

.bad {
  display: inline-block;
  margin-top: 8rpx;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  color: #991B1B;
  background: #FEE2E2;
  font-size: 24rpx;
  font-weight: 600;
}

.review-text {
  margin-top: 12rpx;
  color: var(--text-secondary);
  font-size: 26rpx;
  line-height: 44rpx;
}

.review-item .pill {
  margin-top: 12rpx;
}
