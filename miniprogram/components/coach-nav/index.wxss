.nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 40;
  height: calc(64px + env(safe-area-inset-bottom));
  padding: 0 4px env(safe-area-inset-bottom);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  background: #fffffff2;
  border-top: 1px solid #dce7ff;
}
.item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2px;
  min-height: 48px;
  border-radius: 12px;
  font-size: 10px;
  line-height: 1;
  color: #94a3b8;
}
.selected {
  color: #1e63ff;
  font-weight: 700;
}
