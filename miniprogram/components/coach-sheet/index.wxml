<view
  wx:if="{{open}}"
  class="mask {{motion ? 'motion' : ''}}"
  catchtap="close"
  catchtouchmove="noop"
>
  <view class="panel" catchtap="noop">
    <view class="handle" />
    <view class="heading">
      <view class="copy">
        <view class="title">{{title}}</view>
        <view class="subtitle">{{subtitle}}</view>
      </view>
      <button class="close" bindtap="close">×</button>
    </view>
    <scroll-view scroll-y class="body"><slot /></scroll-view>
  </view>
</view>
