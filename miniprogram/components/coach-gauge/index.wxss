.gauge {
  position: relative;
  flex-shrink: 0;
}
.value {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 20px;
  font-weight: 700;
  line-height: 1;
}
.half .value {
  top: auto;
  bottom: 4px;
  align-items: baseline;
  color: #0f172a;
  font-size: 36px;
  font-weight: 800;
}
.unit {
  font-size: 12px;
  color: #94a3b8;
  font-weight: 500;
}
