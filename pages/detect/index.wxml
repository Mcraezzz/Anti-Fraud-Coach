<view class="page-shell">
  <mp-navigation-bar title="智能风险识别" background="#f5f8ff" color="#0B1F3A">
    <view slot="left" class="nav-slot"><brand-logo size="mini" show-name="{{false}}" /></view>
  </mp-navigation-bar>

  <scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="content">
      <view class="scanner-head">
        <text class="scanner-title">本地规则筛查</text>
        <text class="scanner-subtitle">文本、短信与链接文字按本地关键词筛查；AI、OCR 和网站信誉检测尚未接入。</text>
      </view>

      <view class="type-tabs">
        <view wx:for="{{tabs}}" wx:key="key" class="type-tab {{activeType === item.key ? 'type-tab-active' : ''}}" data-type="{{item.key}}" bind:tap="switchType">
          <text>{{item.label}}</text>
        </view>
      </view>

      <view class="scan-input-panel hairline-card">
        <textarea wx:if="{{activeType === 'text' || activeType === 'sms'}}" class="main-input" maxlength="800" value="{{inputText}}" bindinput="onInput" disabled="{{scanning}}" placeholder="粘贴可疑聊天或短信内容，仅作本地关键词匹配。" placeholder-class="input-placeholder" />
        <view wx:elif="{{activeType === 'image'}}" class="upload-box">
          <text class="upload-title">上传聊天截图</text>
          <text class="upload-desc">OCR 尚未接入，请将截图中的文字粘贴到文本页</text>
        </view>
        <input wx:else class="single-input" maxlength="800" value="{{inputText}}" bindinput="onInput" disabled="{{scanning}}" placeholder="粘贴可疑链接，如短链、下载页、交易页" placeholder-class="input-placeholder" />
        <view class="privacy-bar"><text>输入仅在本页内存中处理，不上传、不持久化；请勿输入真实密码或验证码。</text></view>
      </view>

      <text wx:if="{{error}}" class="form-error">{{error}}</text>
      <button class="primary-button" bindtap="startScan" loading="{{scanning}}" disabled="{{scanning || activeType === 'image'}}">{{scanning ? '正在筛查' : '开始本地筛查'}}</button>
    </view>
  </scroll-view>

  <mp-tabbar class="bottom-tabbar" list="{{tabbarList}}" current="{{currentTab}}" bindchange="onTabChange" />
</view>
