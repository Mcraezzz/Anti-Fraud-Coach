.nav-slot { display: flex; align-items: center; justify-content: center; height: 72rpx; min-width: 72rpx; }
.profile-card { min-height: 300rpx; padding: 32rpx; border: 1rpx solid #dce7ff; border-radius: 32rpx; background: #ffffff; box-shadow: 0 18rpx 44rpx rgba(11, 31, 58, 0.08); }
.profile-note { display: block; margin-top: 30rpx; color: #506174; font-size: 27rpx; line-height: 40rpx; }
.admin-card { display: flex; align-items: center; justify-content: space-between; min-height: 136rpx; margin-top: 22rpx; padding: 26rpx; border-radius: 28rpx; color: #ffffff; background: linear-gradient(135deg, #0b1f3a 0%, #123d77 100%); box-shadow: 0 18rpx 36rpx rgba(11, 31, 58, 0.12); }
.admin-title, .admin-desc { display: block; }
.admin-title { font-size: 31rpx; font-weight: 900; }
.admin-desc { margin-top: 8rpx; color: #dce7ff; font-size: 24rpx; }
.admin-arrow { font-size: 48rpx; line-height: 48rpx; }
.settings-list { margin-top: 16rpx; }
.setting-cell { display: flex; align-items: center; justify-content: space-between; min-height: 118rpx; padding: 22rpx 24rpx; border-radius: 22rpx; }
.setting-cell + .setting-cell { margin-top: 16rpx; }
.setting-title { display: block; color: #0b1f3a; font-size: 29rpx; font-weight: 900; }
.setting-desc { display: block; margin-top: 8rpx; color: #64748b; font-size: 24rpx; }
.setting-arrow { color: #8ca0bb; font-size: 44rpx; line-height: 44rpx; }
