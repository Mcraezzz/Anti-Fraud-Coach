@import "../../styles/tokens.wxss";
.nav-slot { display: flex; align-items: center; justify-content: center; height: 72rpx; min-width: 72rpx; }
.report-hero { padding: 30rpx; border-radius: 34rpx; color: #ffffff; background: linear-gradient(135deg, #0b1f3a 0%, #123d77 100%); box-shadow: 0 24rpx 48rpx rgba(11, 31, 58, 0.16); }
.report-title { display: block; color: #dce7ff; font-size: 28rpx; font-weight: 800; }
.score-row { display: flex; align-items: flex-end; justify-content: space-between; margin-top: 20rpx; }
.score-main { display: block; color: #ffffff; font-size: 76rpx; font-weight: 900; line-height: 78rpx; }
.score-desc { color: #dce7ff; font-size: 24rpx; }
.level-pill { padding: 14rpx 20rpx; border-radius: 24rpx; color: #0b1f3a; background: #21c58b; font-size: 24rpx; font-weight: 900; }
.week-up { display: block; margin-top: 22rpx; color: #21c58b; font-size: 28rpx; font-weight: 900; }
.radar-card { margin-top: 22rpx; padding: 16rpx; border-radius: 28rpx; }
.radar-image { width: 100%; height: 360rpx; }
.ability-list { margin-top: 20rpx; padding: 22rpx; border-radius: 28rpx; background: #ffffff; }
.ability-cell { display: flex; align-items: center; min-height: 58rpx; color: #0b1f3a; font-size: 24rpx; font-weight: 800; }
.ability-cell > text:first-child { width: 178rpx; }
.ability-cell > text:last-child { width: 48rpx; text-align: right; }
.ability-track { flex: 1; height: 10rpx; margin: 0 16rpx; border-radius: 10rpx; background: #edf3ff; overflow: hidden; }
.ability-fill { height: 10rpx; border-radius: 10rpx; background: #1e63ff; }
.result-card { margin-top: 22rpx; padding: 24rpx; border-radius: 28rpx; }
.card-title { display: block; color: #0b1f3a; font-size: 30rpx; font-weight: 900; }
.rank-row { display: flex; align-items: center; height: 58rpx; color: #0b1f3a; font-size: 27rpx; font-weight: 800; }
.rank-index { display: flex; align-items: center; justify-content: center; width: 36rpx; height: 36rpx; margin-right: 14rpx; border-radius: 18rpx; color: #ffffff; background: #ff9f1c; font-size: 22rpx; }
.suggest-card { margin-top: 22rpx; padding: 24rpx; border-radius: 28rpx; color: #174d3c; background: #e8fff6; }
.suggest-title, .suggest-body { display: block; }
.suggest-title { font-size: 28rpx; font-weight: 900; }
.suggest-body { margin-top: 10rpx; font-size: 25rpx; line-height: 38rpx; }
